# Gemini (server-only — never expose to client)
# REQUIRED: Google AI Studio API key (starts with AIza), NOT a Google Cloud OAuth token.
# Create one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
