# Postmark Configuration
# Get your Postmark Server API Token from: https://account.postmarkapp.com/servers
POSTMARK_TOKEN=24ce90df-927b-4722-b3d2-87536ca0f082

# Email Configuration
# The email address where contact form submissions will be sent
CONTACT_EMAIL=dawit.abrahame@eaglelionsystems.com

# The "From" email address for Postmark emails
# This must be a verified sender signature in your Postmark account
POSTMARK_FROM_EMAIL=dawit.abrahame@eaglelionsystems.com

# Chatbot / site contact (public — exposed to client)
WHATSAPP_NUMBER=251924909098
SUPPORT_PHONE=+251 924 909 098

# Gemini (server-only — never expose to client)
# Create a key at: https://aistudio.google.com/apikey
# New AI Studio keys start with "AQ." (auth keys) and work with this app's native Gemini SDK.
# Older "AIza" standard keys still work until Google phases them out (Sep 2026).
GEMINI_API_KEY=
# Use a model with free-tier quota for your project. If one model returns quota 0,
# the server automatically tries fallbacks (flash-lite, etc.).
GEMINI_MODEL=gemini-flash-lite-latest
